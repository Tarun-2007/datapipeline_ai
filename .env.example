# ==============================================================================
# DataPulse AI - Environment Configuration (.env.example)
# Copy this file to .env and customize values as appropriate.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# PostgreSQL Analytical Warehouse Configuration
# For Docker Compose:
DATABASE_URL=postgresql+psycopg2://datapulse_user:datapulse_secret@localhost:5432/datapulse
POSTGRES_USER=datapulse_user
POSTGRES_PASSWORD=datapulse_secret
POSTGRES_DB=datapulse

# SQLite Local Zero-Config Fallback (Uncomment to run without Docker/Postgres):
# DATABASE_URL=sqlite:///datapulse.db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1

# Streamlit Dashboard Configuration
DASHBOARD_PORT=8501

# Airflow Credentials
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
